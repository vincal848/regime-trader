# Copy to .env and fill in. .env is gitignored and never logged.
# IB Gateway (paper): 4002 is the default paper API port; live (4001) is refused.
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=17
IB_ACCOUNT=DUxxxxxxx
# Telegram alerts (outbound only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Nightly review (Anthropic API) and its monthly budget in USD
ANTHROPIC_API_KEY=
LLM_MONTHLY_BUDGET_USD=20
